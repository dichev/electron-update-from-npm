{
  "name": "electron-update-from-npm",
  "version": "0.1.0",
  "type": "module",
  "description": "Self-update and launcher shortcuts for Electron apps installed from npm or GitHub, private repos too (npm i -g / npx) — no installers, no code signing",
  "license": "MIT",
  "author": "dichev <dichev.lab@gmail.com>",
  "homepage": "https://github.com/dichev/electron-update-from-npm#readme",
  "bugs": "https://github.com/dichev/electron-update-from-npm/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dichev/electron-update-from-npm.git"
  },
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./src/index.js"
    },
    "./launch-mode": {
      "types": "./types/launch-mode.d.ts",
      "default": "./src/launch-mode.js"
    }
  },
  "types": "./types/index.d.ts",
  "files": [
    "src",
    "types"
  ],
  "scripts": {
    "start": "electron example",
    "test": "vitest run"
  },
  "dependencies": {
    "hosted-git-info": "^10.1.1",
    "latest-version": "^9.0.0",
    "semver": "^7.8.5"
  },
  "peerDependencies": {
    "electron": ">=30"
  },
  "devDependencies": {
    "electron": "^44.4.5",
    "vitest": "^5.0.2"
  },
  "keywords": [
    "electron",
    "electron-updater",
    "auto-update",
    "autoupdate",
    "auto-updater",
    "self-update",
    "updater",
    "update",
    "npm",
    "npx",
    "npm-global",
    "github",
    "git",
    "private-repo",
    "no-installer",
    "installer",
    "distribution",
    "shortcuts",
    "desktop-shortcut",
    "start-menu",
    "launcher",
    "windows",
    "macos"
  ]
}
