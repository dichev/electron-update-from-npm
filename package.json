{
  "name": "electron-update-from-npm",
  "version": "1.0.4",
  "type": "module",
  "description": "Self-update and launcher shortcuts for Electron apps installed from npm or GitHub, private repos too (npm i -g / npx) — no installers, no code signing",
  "license": "MIT",
  "author": "dichev <dichev.lab@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dichev/electron-update-from-npm.git"
  },
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./src/index.js"
    },
    "./launch-mode": {
      "types": "./types/launch-mode.d.ts",
      "default": "./src/launch-mode.js"
    }
  },
  "types": "./types/index.d.ts",
  "files": [
    "bin",
    "src",
    "types"
  ],
  "scripts": {
    "example:prompt": "electron example/prompt",
    "example:shortcuts": "electron example/shortcuts",
    "test": "vitest run",
    "publish:patch": "npm whoami && npm test && npm version patch && npm publish && git push --follow-tags"
  },
  "dependencies": {
    "hosted-git-info": "^10.1.1",
    "semver": "^7.8.5"
  },
  "peerDependencies": {
    "electron": ">=30"
  },
  "devDependencies": {
    "electron": "^44.4.5",
    "vitest": "^5.0.2"
  },
  "keywords": [
    "electron",
    "electron-updater",
    "auto-update",
    "self-update",
    "npm",
    "npx",
    "github",
    "private-repo",
    "desktop-shortcut",
    "start-menu",
    "windows",
    "macos"
  ]
}
